Bootstrap: docker
From: nvidia/cuda:12.1.0-devel-ubuntu22.04

# Apptainer rendering of the UNMODIFIED Dockerfile, step for step, for the cluster, where
# no Docker daemon is reachable.  Two deliberate differences, both outside the graded files:
#   * the 1 GB ECG-FM checkpoint is copied from the local file instead of gdown (same file,
#     same path /opt/ecgfm/, same symlink into /challenge);
#   * the build context is a staged copy of the worktree filtered with .dockerignore (see
#     batch_container_build.sh), because %files has no ignore file.
# Build (rootless):  apptainer build --fakeroot --ignore-fakeroot-command chagas.sif chagas.def
# The host's fakeroot library needs a newer glibc than Ubuntu 22.04 ships, so %post runs in a
# root-mapped user namespace instead; apt's own sandbox user is disabled for that reason.

%files
    /juice2/scr2/kelvinkn/other_work/edwards/containers/stage /challenge
    /juice2/scr2/kelvinkn/other_work/edwards/physionet2025/submission/mimic_iv_ecg_finetuned.pt /opt/ecgfm/mimic_iv_ecg_finetuned.pt

%post
    export DEBIAN_FRONTEND=noninteractive
    APT='-o APT::Sandbox::User=root -o Dpkg::Options::=--force-unsafe-io'
    apt-get $APT update && apt-get $APT install -y --no-install-recommends \
        python3 python3-pip python3-dev python3-venv curl git wget bzip2 ca-certificates \
        libglib2.0-0 libxext6 libsm6 libxrender1 \
        && rm -rf /var/lib/apt/lists/*
    ln -sf "$(which python3)" /usr/local/bin/python
    python -m pip install --upgrade pip
    pip install gdown
    pip install torch==2.5.1 torchvision==0.20.1 --index-url https://download.pytorch.org/whl/cu118
    pip install "transformers==4.53.0"
    cd /challenge
    pip install -r requirements_linux.txt
    ln -sf /opt/ecgfm/mimic_iv_ecg_finetuned.pt /challenge/mimic_iv_ecg_finetuned.pt
    python -m pip install -e fairseq-signals/

%environment
    export DEBIAN_FRONTEND=noninteractive

%runscript
    cd /challenge && exec "$@"
